{
  "name": "learneest",
  "version": "1.0.0",
  "description": "Integrated tools for learners.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k --success command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.ts",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up ",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint/js": "9.39.2",
    "@types/express": "5.0.6",
    "@types/node": "25.2.1",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.13",
    "async-retry": "1.3.3",
    "autoprefixer": "10.4.20",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "node-pg-migrate": "8.0.4",
    "postcss": "8.4.49",
    "prettier": "3.8.1",
    "swr": "2.4.0",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "dependencies": {
    "@types/jest": "30.0.0",
    "concurrently": "9.2.1",
    "dotenv": "16.4.4",
    "dotenv-expand": "12.0.3",
    "jest": "30.2.0",
    "next": "16.1.6",
    "next-connect": "^1.0.0",
    "pg": "8.17.2",
    "pg-promise": "12.3.0",
    "ts-jest": "29.4.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
