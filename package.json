{
  "name": "learneest",
  "version": "1.0.0",
  "description": "Integrated tools for learners.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-postgres && npm run migrations:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up ",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.ts",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k --success command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.9",
    "async-retry": "^1.3.3",
    "node-pg-migrate": "^8.0.4",
    "prettier": "3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.4",
    "dotenv-expand": "^12.0.3",
    "jest": "^30.2.0",
    "next": "^16.1.3",
    "pg": "^8.17.2",
    "pg-promise": "^12.3.0",
    "ts-jest": "^29.4.6"
  }
}
