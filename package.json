{
  "name": "learneest",
  "version": "1.0.0",
  "description": "Integrated tools for learners.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next  -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up ",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint/js": "9.39.2",
    "@faker-js/faker": "^9.7.0",
    "async-retry": "1.3.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "husky": "9.1.7",
    "node-pg-migrate": "^7.6.1",
    "postcss": "8.4.49",
    "prettier": "3.8.1",
    "swr": "2.4.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "autoprefixer": "^10.4.24",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "concurrently": "9.2.1",
    "cookie": "1.0.2",
    "dotenv": "16.4.4",
    "dotenv-expand": "12.0.3",
    "jest": "30.2.0",
    "next": "16.1.6",
    "next-connect": "^1.0.0",
    "nodemailer": "^7.0.5",
    "pg": "8.17.2",
    "pg-promise": "12.3.0",
    "set-cookie-parser": "2.7.1",
    "uuid": "^11.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
