    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "docker": "^1.0.0",
    "express": "^5.2.1",
    "jest": "^30.2.0",
    "next": "^16.1.3",
    "pg": "^8.17.2",
    "ts-jest": "^29.4.6"
  }
}
